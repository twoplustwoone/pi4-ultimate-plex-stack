[Unit]
Description=Periodic Plex request-pipeline health check

[Timer]
# Calendar, not OnBootSec/OnUnitActiveSec: a monotonic timer whose boot
# trigger is lost has no base after a reboot and never fires again.
OnCalendar=*:0/15
Persistent=true
Unit=pipeline-canary.service

[Install]
WantedBy=timers.target
